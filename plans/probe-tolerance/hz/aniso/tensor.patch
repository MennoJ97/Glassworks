+//! Probe: one JSON request on stdin, then a JSON header line and the channels as raw
+//! little-endian f64 on stdout, so the optimizer can run natively, past WebAssembly's 4 GB.
+use eigenmenno_core::problem::Request2d;
+use std::io::{BufWriter, Read, Write};
+
+fn main() {
+    let mut text = String::new();
+    std::io::stdin().read_to_string(&mut text).unwrap();
+    let mut out = BufWriter::new(std::io::stdout().lock());
+    let result = serde_json::from_str::<Request2d>(&text)
+        .map_err(|e| e.to_string())
+        .and_then(|req| eigenmenno_core::solve2d::solve(&req));
+    match result {
+        Err(e) => writeln!(out, "{}", serde_json::json!({ "error": e })).unwrap(),
+        Ok(mut o) => {
+            // The optimizer only reads the slopes, and the mesh is most of the bytes on a fine one.
+            o.channels.retain(|(n, _)| n.starts_with("gradient"));
+            let names: Vec<_> = o.channels.iter().map(|(n, v)| (n.clone(), v.len())).collect();
+            let meta = serde_json::to_string(&o.meta).unwrap();
+            writeln!(out, "{{\"meta\":{meta},\"channels\":{}}}", serde_json::to_string(&names).unwrap()).unwrap();
+            for (_, v) in &o.channels {
+                v.iter().for_each(|x| out.write_all(&x.to_le_bytes()).unwrap());
+            }
+        }
+    }
+}
